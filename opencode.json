{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.3-flash",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": { "baseURL": "http://192.168.1.149:8080/v1" },
      "models": {
        "openai/Qwen3.8-27B": {
          "name": "Qwen3.8 27B",
          "limit": { "context": 88064, "output": 8192 },
          "options": { "reasoningEffort": "medium" }
        }
      }
    },
    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI Coding Plan",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "REPLACE-WITH-YOUR-ZAI-KEY",
        "timeout": 900000,
        "headerTimeout": 120000
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3 Flash (Z.AI)",
          "limit": { "context": 1048576, "output": 131072 }
        }
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "REPLACE-WITH-YOUR-OPENROUTER-KEY"
      },
      "models": {
        "inclusionai/ling-3.0-flash": {
          "name": "Ling 3.0 Flash",
          "limit": { "context": 262144, "output": 32768 }
        },
        "z-ai/glm-5.3-flash": {
          "name": "GLM-5.3 Flash",
          "limit": { "context": 1048576, "output": 131072 },
          "options": {
            "provider": {
              "order": ["z-ai"],
              "allow_fallbacks": true
            }
          }
        },
        "openai/gpt-5.6-luna-pro": {
          "name": "GPT-5.6 Luna Pro",
          "limit": { "context": 1050000, "output": 128000 }
        },
        "qwen/qwen3.8-flash": {
          "name": "Qwen3.8 Flash",
          "limit": { "context": 1000000, "output": 131072 }
        }
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://192.168.1.194:4000/v1",
        "apiKey": "REPLACE-WITH-YOUR-LITELLM-KEY"
      },
      "models": {
        "Qwen3.8-27B": { "name": "Qwen3.8-27B" }
      }
    }
  },
  "plugin": [
    ".opencode/plugins/graphify.js",
    "https://github.com/ethanimproving/story-to-ship",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "external_directory": "allow"
  }
}
